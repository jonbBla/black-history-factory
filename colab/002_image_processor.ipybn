# ============================================================
# 1. Refresh Black History Factory from GitHub
# ============================================================

import os
import sys
import subprocess

ROOT = "/content/black-history-factory"
REPO_URL = "https://github.com/jonbBla/black-history-factory.git"

if os.path.exists(os.path.join(ROOT, ".git")):
    print("[SETUP] Repository exists. Pulling latest changes...")

    subprocess.run(
        ["git", "-C", ROOT, "fetch", "origin"],
        check=True
    )

    subprocess.run(
        ["git", "-C", ROOT, "reset", "--hard", "origin/HEAD"],
        check=True
    )

    subprocess.run(
        ["git", "-C", ROOT, "clean", "-fd"],
        check=True
    )

else:
    print("[SETUP] Repository not found. Cloning...")

    subprocess.run(
        ["git", "clone", REPO_URL, ROOT],
        check=True
    )

# Make sure the repository is imported first.
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

print("[SETUP] Repository refreshed.")
print("[SETUP] Location:", ROOT)

# Show the commit currently being used.
commit = subprocess.check_output(
    ["git", "-C", ROOT, "rev-parse", "--short", "HEAD"],
    text=True
).strip()

print("[SETUP] Commit:", commit)

