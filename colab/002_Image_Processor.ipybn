from factory.image_engine import run
from factory.utils import read_json, write_json_atomic
from factory import status


def process_one():
    candidates = []

    # --------------------------------------------------------
    # Find jobs that may need image generation
    # --------------------------------------------------------

    if paths.jobs_dir.exists():
        for jid_path in sorted(paths.jobs_dir.iterdir()):
            if not jid_path.is_dir():
                continue

            jid = jid_path.name

            manifest = read_json(
                paths.manifest(jid),
                {}
            ) or {}

            # Only consider jobs that have reached the image stage.
            if manifest.get("status") not in (
                "QWEN_READY",
                "IMAGES_PARTIAL",
                "IMAGES_READY",
            ):
                continue

            scenes = read_json(
                paths.scenes(jid),
                []
            ) or []

            if not scenes:
                continue

            # ------------------------------------------------
            # ACTUAL FILE CHECK
            # ------------------------------------------------

            missing = []

            for index, scene in enumerate(scenes, start=1):

                scene_number = int(
                    scene.get(
                        "scene_number",
                        scene.get("scene_id", index)
                    )
                )

                image_path = paths.image(
                    jid,
                    scene_number
                )

                if (
                    not image_path.exists()
                    or image_path.stat().st_size == 0
                ):
                    missing.append(scene_number)

            # Only queue the job if an image is actually missing.
            if missing:
                candidates.append(
                    (jid, scenes, missing)
                )

    # --------------------------------------------------------
    # Nothing needs generating
    # --------------------------------------------------------

    if not candidates:
        print(
            "[IMAGE] No jobs with missing images."
        )
        return False

    # --------------------------------------------------------
    # Select first job
    # --------------------------------------------------------

    jid, scenes, missing = candidates[0]

    print(
        f"[IMAGE] START {jid}"
    )

    print(
        f"[IMAGE] Total scenes: {len(scenes)}"
    )

    print(
        f"[IMAGE] Missing images: {len(missing)}"
    )

    print(
        f"[IMAGE] Missing scenes: {missing}"
    )

    # --------------------------------------------------------
    # Status
    # --------------------------------------------------------

    status.set_processor(
        paths,
        "image",
        "running",
        jid,
        "image_generation",
        f"0/{len(scenes)}",
        0,
        len(scenes)
    )

    def progress(n, total):

        print(
            f"[IMAGE] Scene {n}/{total}"
        )

        status.set_processor(
            paths,
            "image",
            "running",
            jid,
            "image_generation",
            f"scene {n}/{total}",
            n,
            total
        )

    # --------------------------------------------------------
    # Generate missing images
    # --------------------------------------------------------

    try:

        run(
            paths,
            jid,
            scenes,
            pipe,
            config,
            progress
        )

        # ----------------------------------------------------
        # Verify AFTER generation
        # ----------------------------------------------------

        still_missing = []

        for index, scene in enumerate(
            scenes,
            start=1
        ):

            scene_number = int(
                scene.get(
                    "scene_number",
                    scene.get("scene_id", index)
                )
            )

            image_path = paths.image(
                jid,
                scene_number
            )

            if (
                not image_path.exists()
                or image_path.stat().st_size == 0
            ):
                still_missing.append(scene_number)

        # ----------------------------------------------------
        # Don't claim READY if files are still missing
        # ----------------------------------------------------

        manifest = read_json(
            paths.manifest(jid),
            {}
        ) or {}

        if still_missing:

            manifest["status"] = "IMAGES_PARTIAL"
            manifest["image_error"] = (
                f"Missing images after generation: "
                f"{still_missing}"
            )

            write_json_atomic(
                paths.manifest(jid),
                manifest
            )

            status.set_processor(
                paths,
                "image",
                "error",
                jid,
                "partial",
                f"Still missing: {still_missing}"
            )

            print(
                f"[IMAGE] PARTIAL {jid} | "
                f"Still missing: {still_missing}"
            )

            return False

        # ----------------------------------------------------
        # Everything exists
        # ----------------------------------------------------

        manifest["status"] = "IMAGES_READY"

        # Remove old error if one exists.
        manifest.pop("image_error", None)

        write_json_atomic(
            paths.manifest(jid),
            manifest
        )

        status.set_processor(
            paths,
            "image",
            "idle",
            jid,
            "ready",
            "images complete",
            len(scenes),
            len(scenes)
        )

        print(
            f"[IMAGE] COMPLETE {jid}"
        )

        return True

    except Exception as e:

        manifest = read_json(
            paths.manifest(jid),
            {}
        ) or {}

        manifest.update(
            status="IMAGES_PARTIAL",
            image_error=str(e)
        )

        write_json_atomic(
            paths.manifest(jid),
            manifest
        )

        status.set_processor(
            paths,
            "image",
            "error",
            jid,
            "failed",
            str(e)
        )

        print(
            f"[IMAGE] ERROR {jid} | {e}"
        )

        raise


process_one()

Next steps:

# Optional after the one-video test.
while process_one(): pass

